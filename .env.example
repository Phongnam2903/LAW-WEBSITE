# Root environment file for the local Docker Compose stack (docker-compose.yml).
# Copy to `.env` (gitignored) to override any default. Every variable has a working
# local-only default baked into docker-compose.yml, so this file is optional for a
# bare `docker compose up` — it exists so one place documents every variable name,
# shared verbatim with backend/application-*.yml and frontend/.env.example.
#
# Never put real/production secrets here or in `.env` — see
# docs/technical-foundation/09-environment-configuration.md.

# --- MySQL (docker-compose `mysql` service + backend `local`/`test` profiles) ---
DB_NAME=lawfirm
DB_USERNAME=lawfirm
DB_PASSWORD=lawfirm
DB_PORT=3307
MYSQL_ROOT_PASSWORD=root

# --- MinIO (docker-compose `minio` service + backend `local`/`test` profiles) ---
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=lawfirm-documents

# --- Frontend (docker-compose `full` profile `frontend` service) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- AI Agent (docker-compose `full` profile `agent` service, ai_agent/) ---
# Leave OPENAI_API_KEY empty for local dev without an LLM — the current agent
# nodes are placeholders and never call OpenAI. Required once real LLM calls
# are wired up. Override AGENT_PORT if 8000 is already taken on your machine.
OPENAI_API_KEY=
AGENT_PORT=8000
