# AI Agent Configuration
APP_NAME=AI-Agent
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# LLM Provider: "gemini" (siêu tốc 1s, miễn phí) hoặc "ollama" (offline local)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama Local Configuration (dùng khi LLM_PROVIDER=ollama hoặc fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
